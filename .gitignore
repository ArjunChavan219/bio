# dependencies
/node_modules

# next.js
/.next
/out

# build output published to pages
# (docs/ IS committed — it's what GitHub Pages serves; remove the next line if you don't want it tracked)

# project docs / markdown — keep these local, never commit (README is the exception)
*.md
!README.md

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
